#!/bin/bash
# squad — tmux マルチエージェントシステム CLI
#
# start.sh / stop.sh のラッパー + セッション状態の確認。squad ディレクトリに
# cd しなくても任意の場所から操作できる。~/.local/bin 等への symlink を想定
# (readlink -f で実体を辿って SQUAD_ROOT を解決する)。
#
# 使い方:
#   squad start <workspace> [-s <session>] [-p <projects>]
#                                            # 起動。-s 省略時は対話で聞く (既定 ros-agents)
#                                            # -p は担当 project (カンマ区切り)
#   squad stop [<session>]                   # 停止 (並行運用時は明示必須)
#   squad muster                             # 全 squad を横断表示 (中隊ビュー)
#   squad order -s <s1,s2> "<指示>"          # 選んだ Dispatcher に同じ指示を送る
#   squad hq [-s <hq-session>]               # squad を tmux tab に束ねた HQ を作る
#   squad status                             # muster の別名
#   squad attach [<session>]                 # tmux attach
#   squad log [<session>] [-f]               # watcher ログ表示 (-f で follow)
#   squad root                               # SQUAD_ROOT を表示
set -u

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SQUAD_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
DEFAULT_SESSION="${SQUAD_SESSION:-ros-agents}"

usage() {
    sed -n '/^# 使い方:/,/^# *squad root/{s/^# \{0,3\}//p}' "$SELF"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    start)
        workspace=""
        # 既定値をここで埋めない: 埋めると start.sh 側の対話フォールバック
        # (セッション名・担当 project を聞く) が squad 経由では発火しなくなる
        session="${SQUAD_SESSION:-}"
        projects="${SQUAD_OWNED_PROJECTS:-}"
        while [ $# -gt 0 ]; do
            case "$1" in
                -s|--session) session="$2"; shift 2 ;;
                -p|--projects) projects="$2"; shift 2 ;;
                -*) echo "不明なオプション: $1" >&2; exit 1 ;;
                *) workspace="$1"; shift ;;
            esac
        done
        if [ -z "$workspace" ]; then
            echo "使用方法: squad start <workspace> [-s <session>] [-p <project1,project2>]" >&2
            exit 1
        fi
        exec env ${session:+SQUAD_SESSION="$session"} \
            ${projects:+SQUAD_OWNED_PROJECTS="$projects"} \
            "$SQUAD_ROOT/start.sh" "$workspace"
        ;;
    stop)
        exec "$SQUAD_ROOT/stop.sh" "$@"
        ;;
    status|muster)
        exec python3 "$SQUAD_ROOT/squad/squad.py" muster
        ;;
    attach)
        exec tmux attach -t "${1:-$DEFAULT_SESSION}"
        ;;
    log)
        session="$DEFAULT_SESSION"
        follow=0
        while [ $# -gt 0 ]; do
            case "$1" in
                -f|--follow) follow=1; shift ;;
                *) session="$1"; shift ;;
            esac
        done
        logfile="/tmp/${session}-watch.log"
        [ -f "$logfile" ] || { echo "ログがありません: $logfile" >&2; exit 1; }
        if [ "$follow" -eq 1 ]; then
            exec tail -f "$logfile"
        else
            exec tail -n 50 "$logfile"
        fi
        ;;
    root)
        echo "$SQUAD_ROOT"
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        # squad.py 側のサブコマンド (ls / assign / order / hq / dashboard / ledger / notify) に流す
        exec python3 "$SQUAD_ROOT/squad/squad.py" "$cmd" "$@"
        ;;
esac
